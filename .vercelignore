# The FastAPI backend deploys to Render via render.yaml.
# Vercel only needs the Next.js app at the repo root.
#
# IMPORTANT: these MUST have a leading slash. Without it, ".vercelignore"
# uses gitignore semantics where "api/" matches a directory named "api" at
# ANY depth — including "src/app/api/", which silently strips every Next.js
# API route (smtp-connect, campaigns/[id]/tick, smtp-relay) from the build.
# "/api/" anchors the exclusion to the repo root only.
/api/
/extension/
docker-compose.yml
render.yaml
railway.json
