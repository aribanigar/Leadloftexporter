APP_ENV=development
APP_NAME=LeadCaptura
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/leadcaptura
REDIS_URL=redis://localhost:6379/0

# CORS
FRONTEND_ORIGINS=http://localhost:3000,chrome-extension://*

# Email
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback

# AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# Stripe (optional v1)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sentry
SENTRY_DSN=
