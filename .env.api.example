# ── LeadCaptura backend (api/) — copy to api/.env and fill in ──────────────
# Required
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
PUBLIC_API_URL=https://your-backend.onrender.com
REDIS_URL=redis://localhost:6379/0

# AI (optional — fallbacks exist)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# Gmail send (optional)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# Google Calendar OAuth (optional; redirect auto-derives from PUBLIC_API_URL if blank)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Company Finder (optional)
GOOGLE_PLACES_API_KEY=

# Cron + content routine (optional)
CRON_SECRET=
CONTENT_INGEST_TOKEN=            # NEW: shared secret for POST /content-hub/ingest

# SMTP relay via Vercel (optional; Render blocks outbound SMTP)
SMTP_RELAY_URL=https://your-frontend.vercel.app/api/smtp-relay
SMTP_RELAY_SECRET=

# WhatsApp sidecar (optional)
WA_SIDECAR_URL=
WA_SIDECAR_TOKEN=

# Misc (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=
