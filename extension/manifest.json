{
  "manifest_version": 3,
  "name": "LeadLoft Exporter",
  "version": "1.4.0",
  "description": "Detect lead tables on LeadLoft pages and export them to a CSV file with proper columns.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.leadloft.com/*",
    "https://leadloft.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LeadLoft Exporter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.leadloft.com/*",
        "https://leadloft.com/*"
      ],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.leadloft.com/*",
        "https://leadloft.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
