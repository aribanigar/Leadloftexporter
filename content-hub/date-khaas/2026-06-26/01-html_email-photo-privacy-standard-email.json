  "body": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Your photos. Your control. Your nikah.</title>\n</head>\n<body style=\"margin:0;padding:0;background-color:#f5f3ee;font-family:Helvetica,Arial,sans-serif;\">\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f5f3ee;\">\n  <tr>\n    <td align=\"center\" style=\"padding:32px 16px;\">\n      <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;width:100%;background-color:#ffffff;border-radius:8px;overflow:hidden;box-shadow:0 2px 12px rgba(0,53,39,0.08);\">\n\n        <!-- HEADER -->\n        <tr>\n          <td style=\"background-color:#003527;padding:28px 40px;text-align:center;\">\n            <p style=\"margin:0;font-family:Georgia,'Times New Roman',serif;font-size:30px;font-weight:700;color:#e9c176;letter-spacing:3px;\">Date Khaas</p>\n            <p style=\"margin:8px 0 0;font-family:Helvetica,Arial,sans-serif;font-size:11px;color:#a8c4b8;letter-spacing:4px;text-transform:uppercase;\">Muslim Matrimony</p>\n          </td>\n        </tr>\n\n        <!-- HERO IMAGE -->\n        <tr>\n          <td style=\"padding:0;line-height:0;\">\n            <img src=\"https://datekhaas.com/email/hero-wedding.jpg\" alt=\"A beautiful nikah ceremony — golden light, flowers, and the promise of forever\" width=\"600\" style=\"width:100%;max-width:600px;display:block;\" />\n          </td>\n        </tr>\n\n        <!-- HERO COPY -->\n        <tr>\n          <td style=\"padding:48px 40px 32px;text-align:center;\">\n            <h1 style=\"margin:0 0 20px;font-family:Georgia,'Times New Roman',serif;font-size:36px;font-weight:400;color:#003527;line-height:1.3;letter-spacing:-0.5px;\">\n              You deserve a love<br>that begins with safety.\n            </h1>\n            <p style=\"margin:0 0 20px;font-family:Helvetica,Arial,sans-serif;font-size:17px;color:#5a6a7a;line-height:1.75;\">\n              There is a kind of peace — <em>sukoon</em> — in knowing the person reaching out to you is truly who they say they are. That their intentions are as honest as your own longing for a righteous marriage.\n            </p>\n            <p style=\"margin:0;font-family:Georgia,'Times New Roman',serif;font-size:19px;color:#003527;line-height:1.6;font-style:italic;\">\n              That peace is what we built Date Khaas for.\n            </p>\n          </td>\n        </tr>\n\n        <!-- GOLD DIVIDER -->\n        <tr>\n          <td style=\"padding:0 40px;\">\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"border-top:1px solid #e9c176;\"></td></tr></table>\n          </td>\n        </tr>\n\n        <!-- FEATURE 1 -->\n        <tr>\n          <td style=\"padding:32px 40px 20px;\">\n            <table cellpadding=\"0\" cellspacing=\"0\">\n              <tr>\n                <td style=\"width:40px;vertical-align:top;padding-top:3px;\">\n                  <div style=\"width:28px;height:28px;background-color:#003527;border-radius:50%;text-align:center;line-height:28px;font-size:14px;color:#e9c176;\">&#128274;</div>\n                </td>\n                <td style=\"padding-left:16px;\">\n                  <h2 style=\"margin:0 0 10px;font-family:Georgia,'Times New Roman',serif;font-size:22px;font-weight:400;color:#003527;\">Your photos stay yours</h2>\n                  <p style=\"margin:0;font-family:Helvetica,Arial,sans-serif;font-size:16px;color:#5a6a7a;line-height:1.7;\">\n                    On Date Khaas, your photos are blurred by default. You unlock them only when a conversation feels right — when there is real intent on both sides. Your face is an <em>amanah</em>. We treat it that way.\n                  </p>\n                </td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n\n        <!-- FEATURE 2 -->\n        <tr>\n          <td style=\"padding:0 40px 20px;\">\n            <table cellpadding=\"0\" cellspacing=\"0\">\n              <tr>\n                <td style=\"width:40px;vertical-align:top;padding-top:3px;\">\n                  <div style=\"width:28px;height:28px;background-color:#003527;border-radius:50%;text-align:center;line-height:28px;font-size:14px;color:#e9c176;\">&#10003;</div>\n                </td>\n                <td style=\"padding-left:16px;\">\n                  <h2 style=\"margin:0 0 10px;font-family:Georgia,'Times New Roman',serif;font-size:22px;font-weight:400;color:#003527;\">Every profile, truly verified</h2>\n                  <p style=\"margin:0;font-family:Helvetica,Arial,sans-serif;font-size:16px;color:#5a6a7a;line-height:1.7;\">\n                    We go beyond email confirmation. Real documents. Real people. So you never have to wonder if the name and face in front of you belong to the same person.\n                  </p>\n                </td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n\n        <!-- FEATURE 3 -->\n        <tr>\n          <td style=\"padding:0 40px 32px;\">\n            <table cellpadding=\"0\" cellspacing=\"0\">\n              <tr>\n                <td style=\"width:40px;vertical-align:top;padding-top:3px;\">\n                  <div style=\"width:28px;height:28px;background-color:#003527;border-radius:50%;text-align:center;line-height:28px;font-size:14px;color:#e9c176;\">&#128106;</div>\n                </td>\n                <td style=\"padding-left:16px;\">\n                  <h2 style=\"margin:0 0 10px;font-family:Georgia,'Times New Roman',serif;font-size:22px;font-weight:400;color:#003527;\">Your wali walks beside you</h2>\n                  <p style=\"margin:0;font-family:Helvetica,Arial,sans-serif;font-size:16px;color:#5a6a7a;line-height:1.7;\">\n                    Invite a parent or wali to have read-only visibility of your matches. <em>Nikah</em> is a family matter, and it should feel that way from the very first conversation.\n                  </p>\n                </td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n\n        <!-- GOLD DIVIDER -->\n        <tr>\n          <td style=\"padding:0 40px;\">\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"border-top:1px solid #e9c176;\"></td></tr></table>\n          </td>\n        </tr>\n\n        <!-- CTA BLOCK -->\n        <tr>\n          <td style=\"background-color:#003527;padding:44px 40px;text-align:center;\">\n            <p style=\"margin:0 0 10px;font-family:Georgia,'Times New Roman',serif;font-size:24px;color:#e9c176;font-style:italic;line-height:1.35;\">\n              The one written for you is waiting.\n            </p>\n            <p style=\"margin:0 0 28px;font-family:Helvetica,Arial,sans-serif;font-size:15px;color:#a8c4b8;line-height:1.7;\">\n              Begin your journey with intention, privacy, and <em style=\"color:#e9c176;\">barakah</em>.\n            </p>\n            <a href=\"https://datekhaas.com/join\" style=\"display:inline-block;background-color:#e9c176;color:#003527;font-family:Helvetica,Arial,sans-serif;font-size:14px;font-weight:700;text-decoration:none;padding:16px 44px;border-radius:4px;letter-spacing:1.5px;text-transform:uppercase;\">\n              Create Your Profile\n            </a>\n          </td>\n        </tr>\n\n        <!-- FOOTER -->\n        <tr>\n          <td style=\"padding:24px 40px;text-align:center;background-color:#f9f7f3;\">\n            <p style=\"margin:0 0 8px;font-family:Helvetica,Arial,sans-serif;font-size:12px;color:#999;line-height:1.6;\">\n              Date Khaas &middot; Muslim Matrimony &middot;\n              <a href=\"https://datekhaas.com/privacy\" style=\"color:#888;text-decoration:underline;\">Privacy Policy</a> &middot;\n              <a href=\"https://datekhaas.com/unsubscribe\" style=\"color:#888;text-decoration:underline;\">Unsubscribe</a>\n            </p>\n        